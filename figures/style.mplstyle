# Shared figure style (light). Dark variants add style-dark.mplstyle on top.
# Palette and chrome follow one validated categorical order; see plotting/common.py.

figure.figsize: 8, 3.2
figure.dpi: 100
savefig.dpi: 200
figure.constrained_layout.use: True
figure.constrained_layout.w_pad: 0.06
figure.constrained_layout.h_pad: 0.06
figure.constrained_layout.wspace: 0.04
figure.facecolor: fcfcfb
savefig.facecolor: fcfcfb
axes.facecolor: fcfcfb

font.family: sans-serif
font.sans-serif: Helvetica Neue, Helvetica, Arial, DejaVu Sans
font.size: 9.5
axes.titlesize: 10
axes.titleweight: bold
axes.titlelocation: left
axes.titlepad: 8
axes.labelsize: 9.5
xtick.labelsize: 8.5
ytick.labelsize: 8.5
legend.fontsize: 8.5
legend.frameon: False

text.color: 0b0b0b
axes.labelcolor: 52514e
axes.edgecolor: c3c2b7
axes.linewidth: 0.8
xtick.color: 898781
ytick.color: 898781
xtick.labelcolor: 52514e
ytick.labelcolor: 52514e
xtick.major.size: 0
ytick.major.size: 0
xtick.minor.size: 0
ytick.minor.size: 0
axes.spines.top: False
axes.spines.right: False

axes.grid: True
grid.color: e1e0d9
grid.linewidth: 0.6
grid.linestyle: -
axes.axisbelow: True

lines.linewidth: 1.6
lines.solid_capstyle: round
lines.solid_joinstyle: round
lines.markersize: 5

axes.prop_cycle: cycler('color', ['2a78d6', 'eb6834', '1baf7a', 'eda100', 'e87ba4', '008300', '6250d6'])
image.cmap: Blues
